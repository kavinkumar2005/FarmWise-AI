# ==============================================================================
# FarmwiseAI Environment Template (.env.example)
# Target Region: ap-south-1 (Mumbai) Only
# Copy this file to .env.deploy or .env for local deployment and configuration.
# ==============================================================================

# AWS Authentication & IAM Configuration
AWS_ACCOUNT_ID=100247989552
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_SESSION_TOKEN=your_aws_session_token_here_if_using_assumed_role

# Team Identification & S3/DynamoDB/Lambda Resource Prefix
TEAM_ID=06
RESOURCE_PREFIX=fai-tce-team06
ROLE_ARN=arn:aws:iam::100247989552:role/FAI-TCE-LambdaExecutionRole
EXECUTION_ROLE_ARN=arn:aws:iam::100247989552:role/FAI-TCE-LambdaExecutionRole

# S3 Buckets (Strictly Private, ap-south-1)
S3_BUCKET_UPLOADS=fai-tce-team06-uploads
S3_BUCKET_GEODATA=fai-tce-team06-geodata
S3_BUCKET_ADVISORY=fai-tce-team06-advisory
S3_BUCKET_REPORTS=fai-tce-team06-reports

# DynamoDB Tables (Billing Mode: PAY_PER_REQUEST, ap-south-1)
DYNAMODB_TABLE_RUNS=fai-tce-team06-runs
DYNAMODB_TABLE_PARCELS=fai-tce-team06-parcels
DYNAMODB_TABLE_LANDRECORDS=fai-tce-team06-landrecords
DYNAMODB_TABLE_REFIMAGES=fai-tce-team06-refimages
DYNAMODB_TABLE_ADVISORY_CHUNKS=fai-tce-team06-advisory-chunks
DYNAMODB_TABLE_CHATS=fai-tce-team06-chats
DYNAMODB_TABLE_CACHE=fai-tce-team06-cache

# Lambda Functions (Node.js 20 Runtime, FAI-TCE-LambdaExecutionRole)
LAMBDA_API_GATEWAY_HANDLER=fai-tce-team06-api-gateway-handler
LAMBDA_ORCHESTRATOR=fai-tce-team06-orchestrator
LAMBDA_CHATBOT=fai-tce-team06-chatbot
LAMBDA_REPORT_GENERATOR=fai-tce-team06-report-generator

# Proprietary Model API Keys (Optional; fallbacks to Bedrock / Simulation when absent)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Local Runtime Settings
NODE_ENV=production
PORT=3001
