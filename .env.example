# Local development environment
NODE_ENV=development
PORT=3001
VITE_API_URL=http://localhost:3001

# AWS configuration (Region must always be ap-south-1)
AWS_REGION=ap-south-1
AWS_PROFILE=default

# Team configuration
TEAM_ID=01

# External model API keys (optional if using Bedrock)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
